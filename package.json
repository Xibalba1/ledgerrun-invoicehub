{
  "name": "ledgerrun",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "build": "npm -w web run build",
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "PORT=8791 tsx watch server/src/index.ts",
    "dev:web": "npm -w web run dev",
    "start": "npm -w server start",
    "mcp": "tsx server/src/mcp/server.ts",
    "make:emls": "tsx scripts/make-emls.ts",
    "make:invoice": "tsx scripts/make-invoice.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "eval": "tsx eval/run.ts",
    "eval:offline": "vitest run server/test/eval-smoke.test.ts server/test/deterministic-eval.test.ts",
    "build:web": "npm -w web run build",
    "typecheck": "tsc -p shared/tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:reference": "python -m pytest reference-api/api/tests",
    "verify": "tsx verify.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/coverage-v8": "^2.1.9",
    "concurrently": "^9.1.0",
    "jsdom": "^29.1.1",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
